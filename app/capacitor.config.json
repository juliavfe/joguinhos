{
  "appId": "io.github.juliavfe.joguinhos",
  "appName": "Joguinhos",
  "webDir": "www",
  "backgroundColor": "#F1EADB",
  "ios": { "contentInset": "never", "backgroundColor": "#F1EADB", "scrollEnabled": true },
